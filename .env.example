# OneCare Loop — environment variables
# Copy to .env and fill values. .env is gitignored.
# The app runs with sensible dev defaults if you do nothing.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
ONECARE_DEV_MODE=1

# Database (SQLite by default; Postgres for production)
# ONECARE_DB=onecare.db
# DATABASE_URL=postgresql://user:pass@host/dbname

# Master encryption key (base64-encoded 32 bytes)
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Falls back to a deterministic dev key if unset — DO NOT leave unset in production.
ONECARE_MASTER_KEY=

# SMS / WhatsApp — SIMULATED in demo. Fill to enable real Twilio calls in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LLM reply classification (optional — falls back to keyword matching if unset)
GROQ_API_KEY=

# Server
HOST=127.0.0.1
PORT=5000